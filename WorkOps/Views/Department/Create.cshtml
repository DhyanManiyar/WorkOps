@model WorkOps.Models.CreateDepartmentViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Add New Department";
}

<link href="@Url.Content("~/Content/css/pages/admin-modules.css")" rel="stylesheet" />

<div class="wo-page animate-fade-up">
    <div class="wo-page-header">
        <div>
            <h2>Add New Department</h2>
            <p>Create a new department in your organization</p>
        </div>
        <a href="@Url.Action("Index", "Department")" class="btn-topbar-secondary">
            <i data-lucide="arrow-left" style="width:16px;height:16px;"></i> Back
        </a>
    </div>

    @using (Html.BeginForm("Create", "Department", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

        <div class="form-section wo-form-section">
            <h5 class="section-title wo-form-section__title"><i class="fas fa-building"></i> Department Details</h5>
            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.DepartmentName)
                    @Html.TextBoxFor(m => m.DepartmentName, new { @class = "form-control", placeholder = "e.g., Information Technology" })
                    @Html.ValidationMessageFor(m => m.DepartmentName, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.DepartmentCode)
                    @Html.TextBoxFor(m => m.DepartmentCode, new { @class = "form-control", placeholder = "e.g., IT, HR, FIN", style = "text-transform: uppercase;" })
                    @Html.ValidationMessageFor(m => m.DepartmentCode, "", new { @class = "text-danger" })
                    <small class="text-muted">Uppercase letters only</small>
                </div>
                <div class="col-md-12 mb-3">
                    @Html.LabelFor(m => m.Description)
                    @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 3, placeholder = "Department responsibilities" })
                </div>
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.DepartmentHeadID)
                    @Html.DropDownListFor(m => m.DepartmentHeadID, Model.Employees, "Select Department Head", new { @class = "form-select" })
                    <small class="text-muted">Optional: assign a department head</small>
                </div>
            </div>

            <div class="info-card wo-info-callout">
                <div class="d-flex align-items-start gap-3">
                    <i class="fas fa-info-circle fa-lg" style="color: var(--wo-primary); margin-top: 2px;"></i>
                    <div>
                        <strong>Department code guidelines</strong>
                        <p class="small text-muted mb-0 mt-1">Codes must be unique (e.g. IT, HR, FIN) and represent the department in reports and filters.</p>
                    </div>
                </div>
            </div>

            <div class="wo-form-footer" style="position:static; border:none; padding:16px 0 0; background:transparent;">
                <button type="submit" class="btn-topbar-primary border-0">
                    <i data-lucide="save" style="width:16px;height:16px;"></i> Create Department
                </button>
                <a href="@Url.Action("Index", "Department")" class="btn-topbar-secondary">Cancel</a>
            </div>
        </div>
    }
</div>

@section scripts {
    <script>
        $('#DepartmentCode').on('input', function() {
            $(this).val($(this).val().toUpperCase());
        });
        if (typeof lucide !== 'undefined') lucide.createIcons();
    </script>
}

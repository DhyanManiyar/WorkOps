@using System.Linq
@model WorkOps.Models.DepartmentDetailsViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Department Details";
}

<link href="@Url.Content("~/Content/css/pages/admin-modules.css")" rel="stylesheet" />

@section TopBarActions {
    <a href="@Url.Action("Edit", "Department", new { id = Model.DepartmentID })" class="btn-topbar-primary">
        <i data-lucide="pencil" style="width:16px;height:16px;"></i> Edit
    </a>
    <a href="@Url.Action("Index", "Department")" class="btn-topbar-secondary">
        <i data-lucide="arrow-left" style="width:16px;height:16px;"></i> Back
    </a>
}

<div class="wo-page animate-fade-up">
    <div class="wo-page-header">
        <div>
            <h2>@Model.DepartmentName</h2>
            <p>Department details and team overview</p>
        </div>
        <div>
            @if (Model.IsActive)
            {
                <span class="badge-active-dept">Active</span>
            }
            else
            {
                <span class="badge-inactive-dept">Inactive</span>
            }
        </div>
    </div>

    <div class="detail-card wo-detail-card">
        <h5 class="wo-detail-card__title"><i class="fas fa-info-circle"></i> Department Information</h5>
        <div class="info-row">
            <div class="info-label">Department code</div>
            <div class="info-value"><span class="dept-badge">@Model.DepartmentCode</span></div>
        </div>
        <div class="info-row">
            <div class="info-label">Department head</div>
            <div class="info-value">@Model.DepartmentHead</div>
        </div>
        <div class="info-row">
            <div class="info-label">Description</div>
            <div class="info-value">@(Model.Description ?? "No description provided")</div>
        </div>
        <div class="info-row">
            <div class="info-label">Created</div>
            <div class="info-value">@Model.CreatedDate.ToString("dd MMMM yyyy")</div>
        </div>
        <div class="info-row">
            <div class="info-label">Total employees</div>
            <div class="info-value"><strong>@Model.EmployeeCount</strong></div>
        </div>
    </div>

    <div class="detail-card wo-detail-card">
        <h5 class="wo-detail-card__title"><i class="fas fa-users"></i> Employees (@Model.EmployeeCount)</h5>

        @if (Model.Employees != null && Model.Employees.Any())
        {
            <div class="table-responsive data-table-container-premium" style="margin-bottom:0; box-shadow:none; border:none;">
                <table class="table employee-table mb-0">
                    <thead>
                        <tr>
                            <th>Employee</th>
                            <th>Position</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Joining</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var emp in Model.Employees)
                        {
                            <tr>
                                <td>
                                    <div class="employee-info">
                                        <div class="employee-avatar-sm">@emp.Initials</div>
                                        <span class="fw-semibold">@emp.FullName</span>
                                    </div>
                                </td>
                                <td>@emp.Position</td>
                                <td class="text-muted">@emp.Email</td>
                                <td class="text-muted">@emp.Phone</td>
                                <td>@emp.JoiningDate.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (emp.IsActive)
                                    {
                                        <span class="badge-active">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge-inactive">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <a href="@Url.Action("Details", "Employee", new { id = emp.EmployeeID })" class="action-btn view" title="View"><i class="fas fa-eye"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="wo-empty">
                <i data-lucide="users" style="width:48px;height:48px;opacity:0.3;"></i>
                <p>No employees in this department yet.</p>
                <a href="@Url.Action("Create", "Employee")" class="btn-topbar-primary mt-2">Add Employee</a>
            </div>
        }
    </div>

    <div class="detail-card wo-detail-card">
        <h5 class="wo-detail-card__title"><i class="fas fa-tasks"></i> Recent Tasks</h5>

        @if (Model.RecentTasks != null && Model.RecentTasks.Any())
        {
            <div class="list-group list-group-flush">
                @foreach (var task in Model.RecentTasks)
                {
                    var priorityClass = task.Priority == "Critical" ? "task-priority-critical" : task.Priority == "High" ? "task-priority-high" : task.Priority == "Medium" ? "task-priority-medium" : "task-priority-low";
                    var statusClass = task.Status == "Pending" ? "badge-status-pending" : task.Status == "In Progress" ? "badge-status-progress" : "badge-status-completed";
                    <div class="list-group-item @priorityClass mb-2 rounded border" style="border-color: var(--wo-border) !important;">
                        <div class="d-flex justify-content-between align-items-start gap-3">
                            <div>
                                <h6 class="mb-1 fw-semibold">@task.Title</h6>
                                <small class="text-muted">@task.TaskCode</small>
                            </div>
                            <span class="badge @statusClass">@task.Status</span>
                        </div>
                        <div class="d-flex flex-wrap gap-3 mt-2 small text-muted">
                            <span><i class="fas fa-user me-1"></i>@task.AssignedTo</span>
                            <span><i class="fas fa-calendar me-1"></i>@task.DueDate.ToString("dd/MM/yyyy")</span>
                            <span><i class="fas fa-flag me-1"></i>@task.Priority</span>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="wo-empty">
                <i data-lucide="check-square" style="width:48px;height:48px;opacity:0.3;"></i>
                <p>No tasks found for this department.</p>
            </div>
        }
    </div>
</div>

@section scripts {
    <script>
        if (typeof lucide !== 'undefined') lucide.createIcons();
    </script>
}

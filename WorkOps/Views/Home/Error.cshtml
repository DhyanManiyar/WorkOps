@{
    ViewBag.Title = "Error";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WorkOps — Error</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="@Url.Content("~/Content/css/modern.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/css/pages/auth.css")" rel="stylesheet" />
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="wo-auth-page">
    <div class="wo-auth-card" style="text-align:center;">
        <div class="wo-auth-logo" style="background:linear-gradient(135deg,#ef4444,#dc2626);">
            <i data-lucide="alert-circle" style="width:28px;height:28px;"></i>
        </div>
        <h1 style="font-size:24px;">Something went wrong</h1>
        <p class="text-muted mb-4">An unexpected error occurred. Please try again later.</p>
        <a href="@Url.Action("Login", "Account")" class="wo-auth-submit" style="text-decoration:none;">Go to sign in</a>
    </div>
    <script>if (typeof lucide !== 'undefined') lucide.createIcons();</script>
</body>
</html>

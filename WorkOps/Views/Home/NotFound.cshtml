@{
    ViewBag.Title = "Page Not Found";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WorkOps — Page not found</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="@Url.Content("~/Content/css/modern.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/css/pages/auth.css")" rel="stylesheet" />
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="wo-auth-page">
    <div class="wo-auth-card" style="text-align:center;">
        <div class="wo-auth-logo" style="background:linear-gradient(135deg,var(--wo-primary),var(--wo-secondary));">
            <span style="font-size:22px;font-weight:800;">404</span>
        </div>
        <h1 style="font-size:24px;">Page not found</h1>
        <p class="text-muted mb-4">The page you are looking for does not exist or was moved.</p>
        <a href="@Url.Action("Index", "Home")" class="wo-auth-submit" style="text-decoration:none;margin-bottom:8px;">Back to home</a>
        <br>
        <a href="@Url.Action("Login", "Account")" class="wo-link-muted">Sign in</a>
    </div>
    <script>if (typeof lucide !== 'undefined') lucide.createIcons();</script>
</body>
</html>

@{
    ViewBag.Title = "Contact";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

<div class="wo-public-page">
    <section class="wo-public-hero">
        <h1>Contact us</h1>
        <p class="lead mb-0">@ViewBag.Message</p>
    </section>

    <div class="wo-public-contact-grid">
        <div class="wo-public-card">
            <h3>Support desk</h3>
            <p>
                For technical issues, onboarding support, or access recovery, contact your system administrator
                or email <a href="mailto:support@workops.com">support@workops.com</a>.
            </p>
            <p class="mt-3 mb-0"><strong>Response SLA:</strong> within one business day.</p>
        </div>
        <div class="wo-public-card">
            <h3>Office & hours</h3>
            <address class="mb-3">
                WorkOps Technologies<br>
                123 Business Park, Suite 400<br>
                Mumbai, Maharashtra 400001<br>
                India
            </address>
            <p class="mb-0">Monday - Friday, 9:00 AM - 6:00 PM IST</p>
        </div>
    </div>

    <p class="text-center">
        <a href="@Url.Action("Index", "Home")" class="text-muted">Back to home</a>
    </p>
</div>

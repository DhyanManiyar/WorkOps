@model WorkOps.Models.TaskDetailsViewModel
@{
    Layout = "~/Views/Shared/_EmployeeLayout.cshtml";
    ViewBag.Title = "Task Details";
    bool canStart = ViewBag.CanStart == true;
    bool canSubmit = ViewBag.CanSubmit == true;
}

<div class="wo-page">
    <div class="wo-page-header">
        <div>
            <p class="text-muted small mb-1">@Model.TaskCode</p>
            <h2>@Model.Title</h2>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <span class="badge bg-@Model.PriorityColor">@Model.PriorityText</span>
            <span class="badge bg-@Model.StatusColor">@Model.StatusText</span>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="detail-card wo-detail-card">
                @if (Model.IsOverdue)
                {
                    <div class="alert alert-warning py-2 small">This task is overdue.</div>
                }

                <p class="text-muted">@(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)</p>

                <div class="row small text-muted mb-3 g-3">
                    <div class="col-md-4"><strong>Department:</strong> @Model.Department</div>
                    <div class="col-md-4"><strong>Assigned by:</strong> @Model.AssignedBy</div>
                    <div class="col-md-4"><strong>Due:</strong> @Model.DueDate.ToString("dd/MM/yyyy")</div>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    @if (canStart)
                    {
                        using (Html.BeginForm("UpdateTaskStatus", "EmployeePanel", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.TaskID" />
                            <input type="hidden" name="newStatus" value="2" />
                            <button type="submit" class="btn-emp-primary border-0"
                                    data-wo-confirm="Start working on this task?"
                                    data-wo-confirm-title="Start task"
                                    data-wo-confirm-variant="primary"
                                    data-wo-confirm-ok="Start task">
                                <i data-lucide="play" style="width:16px;height:16px;"></i> Start task
                            </button>
                        }
                    }
                    @if (canSubmit)
                    {
                        using (Html.BeginForm("UpdateTaskStatus", "EmployeePanel", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.TaskID" />
                            <input type="hidden" name="newStatus" value="3" />
                            <button type="submit" class="btn btn-success"
                                    data-wo-confirm="Submit this task for manager approval?"
                                    data-wo-confirm-title="Submit task"
                                    data-wo-confirm-variant="success"
                                    data-wo-confirm-ok="Submit">
                                <i data-lucide="send" style="width:16px;height:16px;"></i> Submit for approval
                            </button>
                        }
                    }
                    <a href="@Url.Action("Tasks", "EmployeePanel")" class="btn-topbar-secondary" style="text-decoration:none;">Back to tasks</a>
                </div>
            </div>

            <div class="detail-card wo-detail-card mt-4">
                <h6 class="wo-chart-card__title"><i data-lucide="message-square" style="width:18px;height:18px;"></i> Comments</h6>
                <div id="commentsList">
                    @if (Model.Comments != null)
                    {
                        foreach (var c in Model.Comments)
                        {
                            <div class="comment-item">
                                <div class="comment-avatar">@c.EmployeeAvatar</div>
                                <div class="flex-grow-1">
                                    <strong class="small">@c.EmployeeName</strong>
                                    <div class="small text-muted">@c.CreatedDate.ToString("dd/MM/yyyy hh:mm tt")</div>
                                    <p class="mb-0 mt-1">@c.CommentText</p>
                                </div>
                            </div>
                        }
                    }
                </div>
                @if (Model.Status < 5)
                {
                    <div class="mt-3">
                        @Html.AntiForgeryToken()
                        <textarea id="commentText" class="form-control mb-2" rows="2" placeholder="Add a comment…"></textarea>
                        <button type="button" id="btnAddComment" class="btn btn-sm btn-primary">Post comment</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
<script>
    $('#btnAddComment').click(function () {
        var text = $('#commentText').val().trim();
        if (!text) return;
        $.post('@Url.Action("AddComment", "EmployeePanel")', {
            taskId: @Model.TaskID,
            comment: text,
            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
        }).done(function (res) {
            if (res.success) {
                location.reload();
            } else {
                alert(res.message || 'Failed to add comment');
            }
        });
    });
</script>
}

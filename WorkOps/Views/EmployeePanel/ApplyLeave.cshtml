@model WorkOps.Models.EmployeeApplyLeaveViewModel
@{
    Layout = "~/Views/Shared/_EmployeeLayout.cshtml";
    ViewBag.Title = "Apply for Leave";
}

<div class="wo-page">
    <div class="wo-page-header">
        <div>
            <h2>Apply for leave</h2>
            <p>Submit a new leave request for manager approval</p>
        </div>
        <a href="@Url.Action("Leaves", "EmployeePanel")" class="btn-topbar-secondary">
            <i data-lucide="arrow-left" style="width:16px;height:16px;"></i> Back
        </a>
    </div>

    <div class="form-section wo-form-section wo-form-card wo-form-card--narrow">
        @using (Html.BeginForm("ApplyLeave", "EmployeePanel", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

            <div class="mb-3">
                @Html.LabelFor(m => m.LeaveTypeID, new { @class = "form-label fw-semibold" })
                @Html.DropDownListFor(m => m.LeaveTypeID, Model.LeaveTypes, "Select leave type", new { @class = "form-select", id = "leaveTypeId" })
                @Html.ValidationMessageFor(m => m.LeaveTypeID, "", new { @class = "text-danger" })
                <div id="balanceHint" class="form-text text-muted"></div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.StartDate, new { @class = "form-label fw-semibold" })
                    @Html.TextBoxFor(m => m.StartDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", id = "startDate" })
                </div>
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.EndDate, new { @class = "form-label fw-semibold" })
                    @Html.TextBoxFor(m => m.EndDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                </div>
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Reason, new { @class = "form-label fw-semibold" })
                @Html.TextAreaFor(m => m.Reason, new { @class = "form-control", rows = 3 })
                @Html.ValidationMessageFor(m => m.Reason, "", new { @class = "text-danger" })
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn-emp-primary border-0">Submit request</button>
                <a href="@Url.Action("Leaves", "EmployeePanel")" class="btn-topbar-secondary" style="text-decoration:none;">Cancel</a>
            </div>
        }
    </div>
</div>

@section scripts {
<script>
    function loadBalance() {
        var typeId = $('#leaveTypeId').val();
        var year = $('#startDate').val() ? new Date($('#startDate').val()).getFullYear() : new Date().getFullYear();
        if (!typeId) return;
        $.get('@Url.Action("GetLeaveBalance", "EmployeePanel")', { leaveTypeId: typeId, year: year }, function (res) {
            if (res.success) {
                $('#balanceHint').text('Available balance: ' + res.remaining + ' of ' + res.total + ' days');
            }
        });
    }
    $('#leaveTypeId, #startDate').change(loadBalance);
    loadBalance();
</script>
}

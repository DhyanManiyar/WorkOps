@using System.Linq
@model List<WorkOps.Models.MonthlyAttendanceReportViewModel>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Attendance Report";
}

<link href="@Url.Content("~/Content/css/pages/admin-modules.css")" rel="stylesheet" />
<link href="@Url.Content("~/Content/css/pages/admin-attendance-leave.css")" rel="stylesheet" />

@section TopBarActions {
    <a href="@Url.Action("Index", "Attendance")" class="btn-topbar-secondary">
        <i data-lucide="arrow-left" style="width:16px;height:16px;"></i> Back
    </a>
    <a href="@Url.Action("Export", "Attendance", new { year = ViewBag.Year, month = ViewBag.Month })" class="btn-topbar-primary">
        <i data-lucide="file-spreadsheet" style="width:16px;height:16px;"></i> Export to Excel
    </a>
}

<div class="wo-page animate-fade-up">
    <div class="wo-page-header">
        <div>
            <h2>Attendance Report</h2>
            <p>Monthly attendance summary</p>
        </div>
    </div>

    <div class="filter-bar-premium wo-filter-bar">
        <form method="get" action="@Url.Action("Report", "Attendance")" class="filter-grid">
            <div class="filter-group">
                <label>Year</label>
                @Html.DropDownList("year", ViewBag.Years as SelectList, new { @class = "filter-input form-select" })
            </div>
            <div class="filter-group">
                <label>Month</label>
                @Html.DropDownList("month", ViewBag.Months as SelectList, new { @class = "filter-input form-select" })
            </div>
            <div class="filter-group filter-buttons">
                <label>&nbsp;</label>
                <button type="submit" class="btn-apply">
                    <i data-lucide="search" style="width:16px;height:16px;"></i> Generate
                </button>
            </div>
        </form>
    </div>

    <div class="data-table-container-premium">
        <div class="wo-card-header" style="padding:16px 20px 0;">
            <h5>Summary for @(new DateTime((int)ViewBag.Year, (int)ViewBag.Month, 1).ToString("MMMM yyyy"))</h5>
        </div>

        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="employee-table">
                    <thead>
                        <tr>
                            <th>Employee</th>
                            <th>Department</th>
                            <th>Present</th>
                            <th>Absent</th>
                            <th>Leave</th>
                            <th>Half Day</th>
                            <th>Total Hours</th>
                            <th>Overtime</th>
                            <th>Late Days</th>
                            <th>Attendance %</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><span class="employee-name">@item.EmployeeName</span></td>
                                <td><span class="dept-badge">@item.Department</span></td>
                                <td>@item.PresentDays</td>
                                <td>@item.AbsentDays</td>
                                <td>@item.LeaveDays</td>
                                <td>@item.HalfDays</td>
                                <td>@item.TotalHours.ToString("F1")</td>
                                <td>@item.OvertimeHours.ToString("F1")</td>
                                <td>@item.LateDays</td>
                                <td>
                                    @{
                                        var percentClass = item.AttendancePercentage >= 90 ? "badge-good" :
                                                          item.AttendancePercentage >= 75 ? "badge-average" : "badge-poor";
                                    }
                                    <span class="@percentClass">@item.AttendancePercentage%</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="report-table-foot">
                            <td colspan="2">Total / Average</td>
                            <td>@Model.Sum(m => m.PresentDays)</td>
                            <td>@Model.Sum(m => m.AbsentDays)</td>
                            <td>@Model.Sum(m => m.LeaveDays)</td>
                            <td>@Model.Sum(m => m.HalfDays)</td>
                            <td>@Model.Sum(m => m.TotalHours).ToString("F1")</td>
                            <td>@Model.Sum(m => m.OvertimeHours).ToString("F1")</td>
                            <td>@Model.Sum(m => m.LateDays)</td>
                            <td>@Math.Round(Model.Average(m => m.AttendancePercentage), 1)%</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
        else
        {
            <div class="wo-empty-state">
                <i data-lucide="bar-chart-3" style="width:48px;height:48px;"></i>
                <p class="mb-0">No attendance records found for this period.</p>
            </div>
        }
    </div>
</div>

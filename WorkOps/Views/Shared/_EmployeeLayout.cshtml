@using WorkOps.Helpers
@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var act = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var userEmail = SessionHelper.GetCurrentUserEmail() ?? "employee@workops.com";
    var roleName = SessionHelper.GetCurrentUserRoleName() ?? "Employee";
    var displayName = roleName;
    if (!string.IsNullOrEmpty(userEmail) && userEmail.Contains("@"))
    {
        var localPart = userEmail.Split('@')[0];
        displayName = char.ToUpper(localPart[0]) + (localPart.Length > 1 ? localPart.Substring(1) : "");
    }
    var initials = displayName.Length >= 2 ? displayName.Substring(0, 2).ToUpper() : "EM";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WorkOps | @ViewBag.Title</title>
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="@Url.Content("~/Content/css/modern.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/css/components.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/css/pages/admin-modules.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/css/pages/panel-pages.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/css/panel-themes.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/css/theme.css")" rel="stylesheet" />
    <script>
        (function () {
            try {
                var t = localStorage.getItem('wo-theme');
                if (t === 'dark' || (!t && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches))
                    document.documentElement.setAttribute('data-theme', 'dark');
            } catch (e) { }
        })();
    </script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="wo-app">

    @if (TempData["SuccessMessage"] != null)
    {
        <input type="hidden" id="woTempSuccess" value="@TempData["SuccessMessage"]" />
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <input type="hidden" id="woTempError" value="@TempData["ErrorMessage"]" />
    }

    <div class="loading-overlay" id="loadingOverlay">
        <div class="loading-panel">
            <div class="loading-logo"><i data-lucide="layers"></i></div>
            <div class="loading-title">Loading resources...</div>
            <div class="loading-bar"><span id="woLoadingProgress"></span></div>
            <div class="loading-hint" id="woLoadingHint">Preparing your workspace</div>
        </div>
    </div>
    <div class="wo-toast-container" id="woToastContainer" aria-live="polite"></div>
    @Html.Partial("_ConfirmModal")
    <div class="wo-sidebar-backdrop" id="woSidebarBackdrop"></div>

    <aside class="wo-sidebar sidebar" id="woSidebar" aria-label="Employee navigation">
        <div class="wo-sidebar__brand sidebar-header">
            <div class="wo-sidebar__logo logo-icon">
                <i data-lucide="user"></i>
            </div>
            <div class="wo-sidebar__title logo-text">Work<span>Ops</span></div>
        </div>
        <p class="wo-panel-label">Employee Portal</p>

        <nav class="wo-sidebar__nav nav-menu">
            <a href="@Url.Action("Dashboard", "EmployeePanel")" class="wo-nav-item nav-link-custom @(act == "Dashboard" ? "active" : "")">
                <i data-lucide="home"></i><span>Dashboard</span>
            </a>
            <a href="@Url.Action("Tasks", "EmployeePanel")" class="wo-nav-item nav-link-custom @(act == "Tasks" || act == "TaskDetails" ? "active" : "")">
                <i data-lucide="check-square"></i><span>My Tasks</span>
            </a>
            <a href="@Url.Action("Attendance", "EmployeePanel")" class="wo-nav-item nav-link-custom @(act == "Attendance" ? "active" : "")">
                <i data-lucide="clock"></i><span>Attendance</span>
            </a>
            <a href="@Url.Action("Leaves", "EmployeePanel")" class="wo-nav-item nav-link-custom @(act == "Leaves" || act == "ApplyLeave" ? "active" : "")">
                <i data-lucide="calendar-days"></i><span>Leaves</span>
            </a>
            <a href="@Url.Action("Profile", "EmployeePanel")" class="wo-nav-item nav-link-custom @(act == "Profile" ? "active" : "")">
                <i data-lucide="user-circle"></i><span>Profile</span>
            </a>
            @if (SessionHelper.IsManager())
            {
                <p class="wo-sidebar__section" style="margin-top:16px;">Manager</p>
                <a href="@Url.Action("Dashboard", "Manager")" class="wo-nav-item nav-link-custom">
                    <i data-lucide="user-cog"></i><span>Manager Panel</span>
                </a>
            }
            @if (SessionHelper.IsAdmin())
            {
                <a href="@Url.Action("Dashboard", "Admin")" class="wo-nav-item nav-link-custom">
                    <i data-lucide="shield"></i><span>Admin Panel</span>
                </a>
            }
        </nav>

        <div class="wo-sidebar__footer">WorkOps &copy; @DateTime.Now.Year</div>
    </aside>

    <div class="wo-shell">
        <header class="wo-topbar unified-topbar">
            <div class="wo-topbar__left topbar-left">
                <button type="button" class="wo-topbar__menu-btn" id="woSidebarToggle" aria-label="Toggle menu">
                    <i data-lucide="menu"></i>
                </button>
                <div class="wo-topbar__titles">
                    <h1 class="wo-topbar__title topbar-title">@ViewBag.Title</h1>
                    <nav class="wo-breadcrumb topbar-breadcrumb" aria-label="Breadcrumb">
                        <a href="@Url.Action("Dashboard", "EmployeePanel")">Portal</a>
                        <i data-lucide="chevron-right" style="width:12px;height:12px;"></i>
                        <span>@act</span>
                    </nav>
                </div>
            </div>
            <div class="wo-topbar__right topbar-right">
                <button type="button" class="wo-theme-toggle" aria-label="Toggle theme" title="Dark mode">
                    <i data-lucide="moon" class="icon-moon" style="width:18px;height:18px;"></i>
                    <i data-lucide="sun" class="icon-sun" style="width:18px;height:18px;"></i>
                </button>
                <div class="wo-topbar__actions action-buttons-group">
                    @RenderSection("TopBarActions", required: false)
                </div>
                @Html.Partial("_NotificationDropdown")
                <div class="dropdown wo-user-menu">
                    <button type="button" class="wo-user-trigger user-dropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="wo-user-avatar user-avatar-top">@initials</div>
                        <div class="wo-user-meta d-none d-md-block">
                            <span class="wo-user-meta__name user-name">@displayName</span>
                            <span class="wo-user-meta__email">@userEmail</span>
                            <span class="wo-role-badge">@roleName</span>
                        </div>
                        <i data-lucide="chevron-down" style="width:14px;height:14px;color:#94a3b8;"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end wo-user-dropdown">
                        <li>
                            <a class="dropdown-item" href="@Url.Action("Profile", "EmployeePanel")">
                                <i data-lucide="user" style="width:16px;height:16px;"></i> Profile
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        @Html.Partial("_LogoutDropdownItem")
                    </ul>
                </div>
            </div>
        </header>
        <main class="wo-main main-content">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="@Url.Content("~/Scripts/theme.js")"></script>
    <script src="@Url.Content("~/Scripts/modern.js")"></script>
    @RenderSection("scripts", required: false)
    <script>if (typeof lucide !== 'undefined') lucide.createIcons();</script>
</body>
</html>

<div class="modal fade wo-confirm-modal" id="woConfirmModal" tabindex="-1" aria-labelledby="woConfirmTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content wo-confirm-modal__content">
            <div class="modal-header border-0 pb-0">
                <div class="wo-confirm-modal__icon" aria-hidden="true">
                    <i data-lucide="alert-circle"></i>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-2">
                <h5 class="modal-title mb-2" id="woConfirmTitle">Confirm action</h5>
                <p class="mb-0 text-secondary" id="woConfirmMessage">Are you sure you want to continue?</p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light" id="woConfirmCancel" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="woConfirmOk">Confirm</button>
            </div>
        </div>
    </div>
</div>

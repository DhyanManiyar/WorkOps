<div class="dropdown wo-notify-wrap">
    <button type="button" class="wo-notify-btn notification-icon" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Notifications">
        <i data-lucide="bell"></i>
        <span class="wo-notify-badge notification-badge" id="woNotifyBadge" style="display:none;">0</span>
    </button>
    <div class="dropdown-menu dropdown-menu-end wo-notify-dropdown">
        <div class="wo-notify-dropdown__head">
            <strong>Notifications</strong>
            <button type="button" class="wo-notify-clear" id="woNotifyClear">Mark all read</button>
        </div>
        <div class="wo-notify-dropdown__list" id="woNotifyList">
            <div class="wo-notify-empty">No new notifications</div>
        </div>
    </div>
</div>

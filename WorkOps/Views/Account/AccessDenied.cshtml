@{
    ViewBag.Title = "Access Denied";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WorkOps — Access denied</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="@Url.Content("~/Content/css/modern.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/css/pages/auth.css")" rel="stylesheet" />
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="wo-auth-page">
    <div class="wo-auth-card" style="text-align:center;">
        <div class="wo-auth-logo" style="background:linear-gradient(135deg,#ef4444,#dc2626);margin-bottom:20px;">
            <i data-lucide="shield-off" style="width:28px;height:28px;"></i>
        </div>
        <h1 style="font-size:24px;margin-bottom:8px;">Access denied</h1>
        <p class="text-muted mb-4">You do not have permission to access this page.</p>
        <a href="@Url.Action("Login", "Account")" class="wo-auth-submit" style="text-decoration:none;">
            <i data-lucide="log-in" style="width:18px;height:18px;"></i> Go to sign in
        </a>
    </div>
    <script>if (typeof lucide !== 'undefined') lucide.createIcons();</script>
</body>
</html>

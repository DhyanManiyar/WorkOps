@model WorkOps.Models.LoginViewModel
@{
    ViewBag.Title = "Login - WorkOps";
    Layout = null;
    var allowSelfRegistration = System.Configuration.ConfigurationManager.AppSettings["AllowSelfRegistration"] == "true";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WorkOps | Sign in</title>
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="@Url.Content("~/Content/css/modern.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/css/pages/auth.css")" rel="stylesheet" />
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="wo-auth-page">
    <div class="wo-auth-shell">
        <aside class="wo-auth-aside" aria-hidden="true">
            <div class="wo-auth-aside__inner">
                <div class="wo-auth-aside__logo">
                    <i data-lucide="layers" style="width:26px;height:26px;"></i>
                </div>
                <h2>Manage your workforce in one place</h2>
                <p>Attendance, tasks, leave, and team insights for admins, managers, and employees.</p>
                <ul class="wo-auth-aside__features">
                    <li><i data-lucide="check-circle" style="width:18px;height:18px;"></i> Role-based dashboards</li>
                    <li><i data-lucide="check-circle" style="width:18px;height:18px;"></i> Real-time attendance</li>
                    <li><i data-lucide="check-circle" style="width:18px;height:18px;"></i> Task &amp; leave workflows</li>
                </ul>
            </div>
        </aside>

        <div class="wo-auth-main">
            <div class="wo-auth-card">
                <div class="wo-auth-brand wo-auth-brand--compact">
                    <div class="wo-auth-logo">
                        <i data-lucide="layers" style="width:22px;height:22px;"></i>
                    </div>
                    <h1>Sign in</h1>
                    <p>Enter your WorkOps account credentials</p>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success py-2 small mb-3">@TempData["SuccessMessage"]</div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger py-2 small mb-3">@TempData["ErrorMessage"]</div>
                }

                @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "needs-validation" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

                    <div class="mb-3">
                        @Html.LabelFor(model => model.Email, new { @class = "form-label" })
                        @Html.TextBoxFor(model => model.Email, new { @class = "form-control", placeholder = "you@company.com", autofocus = "autofocus" })
                        @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(model => model.Password, new { @class = "form-label" })
                        @Html.PasswordFor(model => model.Password, new { @class = "form-control", placeholder = "Password" })
                        @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3 form-check">
                        @Html.CheckBoxFor(model => model.RememberMe, new { @class = "form-check-input" })
                        @Html.LabelFor(model => model.RememberMe, new { @class = "form-check-label small" })
                    </div>

                    <button type="submit" class="wo-auth-submit">
                        <i data-lucide="log-in" style="width:18px;height:18px;"></i> Sign in
                    </button>
                }

                <div class="wo-demo-box">
                    <h6>Demo credentials</h6>
                    <p><strong>Admin:</strong> admin@workops.com / Admin@123</p>
                    <hr>
                    <p><strong>Manager:</strong> manager@workops.com / Manager@123</p>
                    <hr>
                    <p><strong>Employee:</strong> employee1@workops.com / Employee@123</p>
                </div>

                <div class="wo-auth-footer">
                    @if (allowSelfRegistration)
                    {
                        <p class="wo-auth-footer__register mb-2">
                            New here?
                            <a href="@Url.Action("Register", "Account")">Create an account</a>
                        </p>
                    }
                    <a href="@Url.Action("Index", "Home")"><i data-lucide="arrow-left" style="width:14px;height:14px;"></i> Back to home</a>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    <script>if (typeof lucide !== 'undefined') lucide.createIcons();</script>
    <script>
        (function () {
            if (window.history && window.history.replaceState) {
                window.history.replaceState(null, document.title, window.location.href);
            }
            window.addEventListener('pageshow', function (e) {
                if (e.persisted) window.location.reload();
            });
        })();
    </script>
</body>
</html>
